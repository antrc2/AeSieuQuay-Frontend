# Chỉ dùng cho `npm run build`.
VITE_API_BASE_URL=/api

# Nguồn dữ liệu trang (build mặc định đã là window.DATA — chỉ ép mock khi test offline).
# VITE_DATA_SOURCE=window

# Domain chuẩn cho canonical/OG (không có dấu / ở cuối).
# Để trống sẽ fallback về window.location.origin.
# VITE_SITE_URL=https://aesieuquay.com