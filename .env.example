# Vite tự nạp file theo mode — KHÔNG cần VITE_ENV:
#   npm run dev   → .env + .env.development
#   npm run build → .env + .env.production
# Muốn ép nguồn dữ liệu: VITE_DATA_SOURCE=mock|window (xem bên dưới).

# URL backend API.
# dev: http://localhost:5000/api
# prod: /api
VITE_API_BASE_URL=/api

# Nguồn dữ liệu trang.
# - mock   : dùng mock trong src/mock-data (mặc định ở dev)
# - window : đọc window.DATA do backend SSR nhúng (mặc định ở production build)
# VITE_DATA_SOURCE=window

# Domain chuẩn cho canonical/OG, không có dấu / ở cuối.
# VITE_SITE_URL=https://aesieuquay.com

# Cloudflare Turnstile (captcha) — site key public (bắt đầu bằng 0x4...).
# Tạo tại: https://dash.cloudflare.com/?to=/:account/turnstile
# Widget hiển thị công khai (KHÔNG hidden) và tự động xác minh (managed challenge).
# Token trả về được frontend gửi lên backend qua field `turnstile_token`
# trong body POST /auth/login và /auth/register.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=