# Biến dùng chung cho MỌI mode.
# Vite tự nạp .env + .env.<mode> (development/production); KHÔNG cần VITE_ENV.
# File mode (.env.development/.env.production) GHI ĐÈ biến trùng tên ở đây.
# Đồng bộ key với .env.example (mọi biến code thật sự đọc: grep import.meta.env).

# URL backend API (dev override trong .env.development = http://localhost:5000/api).
VITE_API_BASE_URL=/api

# Nguồn dữ liệu trang: mock | window (bỏ trống = dev→mock, build→window theo code).
# VITE_DATA_SOURCE=

# Domain chuẩn canonical/OG, không có dấu / ở cuối (bỏ trống = window.location.origin).
# VITE_SITE_URL=
