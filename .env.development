# Chỉ dùng cho `npm run dev`.
VITE_API_BASE_URL=http://localhost:5000/api

# Bỏ comment để dev đọc window.DATA thay vì mock (test shape production):
# VITE_DATA_SOURCE=window

# Khu admin (/admin/**) LUÔN gọi API thật http://localhost:5000/api theo mặc định.
# Bỏ comment nếu backend chưa chạy và muốn admin dùng mock in-memory:
# VITE_DATA_SOURCE=mock